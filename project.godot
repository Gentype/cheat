; Engine configuration file.
; Mydriasis — Mydriasis Studio internal build.
;
; Файл держится сознательно маленьким: всё, что должно быть настраиваемым
; (качество, виталитеты, ракурсы камеры, реквизит), описано кодом и данными
; в resources/. Здесь только точка входа и порядок автолоадов.

config_version=5

[application]

config/name="Mydriasis"
config/description="Психологический боди-хоррор о распаде восприятия на грани жизни и смерти. Тело героя — дыра в кадре, видны только руки и маска."
config/version="0.1.0"
run/main_scene="res://scenes/ui/splash.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

InputActions="*res://scripts/autoload/input_actions.gd"
GameState="*res://scripts/autoload/game_state.gd"
Quality="*res://scripts/autoload/quality.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

3d/default_gravity=9.8
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
