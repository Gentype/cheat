# Правила линтера проекта.
# Максимальная длина строки — 120 символов: в коде много русских комментариев,
# которые не должны ломать проверку (линтер считает символы, а не байты).
max-line-length: 120
# MeshBuilder._tri — сознательно «широкий» примитив: 3 точки, 3 нормали, 3 UV,
# опорная нормаль и цвет. Дробить его на структуры вредно для читаемости.
function-arguments-number: 14
# Порядок объявлений проверяем глазами: в проекте есть файлы, где константы
# стоят рядом с сигналом по смыслу, и это осознанное решение.
disable:
  - class-definitions-order
